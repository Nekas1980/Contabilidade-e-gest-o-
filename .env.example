# Nunca colocar valores reais neste ficheiro versionado.
# Configurar estes valores no fornecedor de backend (ex.: Vercel).

# Origens autorizadas, separadas por vírgula.
# Enquanto o frontend estiver no GitHub Pages:
ALLOWED_ORIGINS=https://nekas1980.github.io

# Envio de e-mail transacional
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=Website CT <no-reply@seudominio.pt>

# WhatsApp Business Cloud API — opcional.
# A notificação usada pelo backend não inclui dados pessoais do pedido.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_PT
